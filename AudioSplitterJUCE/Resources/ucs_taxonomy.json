  "namingRules": {
    "format": "Category_Subcategory_Description_Channel.wav",
    "categoryMaxLength": 6,
    "subcategoryMaxLength": 20,
    "descriptionMaxLength": 50,
    "descriptionRules": [
      "Use CamelCase or underscores",
      "Avoid spaces (use underscores or CamelCase)",
      "Keep concise but descriptive",
      "Include key characteristics (material, intensity, etc.)"
    ],
    "examples": [
      "AMBNat_Forest_MorningBirds_L.wav",
